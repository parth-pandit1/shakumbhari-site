# Search Engine Indexing Guard
# Set to 'false' during development and pre-launch to prevent crawler indexing.
# Set to 'true' only when all placeholder content is replaced with real showroom facts.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Section Preview Mode (Part 4)
# When 'true', displays preview datasets for Happy Customers and Manager sections.
# MUST be 'false' before launch. check-placeholders script prevents build if indexing is true while this is true.
NEXT_PUBLIC_PREVIEW_SECTIONS=false

# Canonical site URL — used by sitemap.ts when NEXT_PUBLIC_ALLOW_INDEXING=true.
# Include no trailing slash. Set to your real domain in Cloudflare Pages environment variables.
NEXT_PUBLIC_SITE_URL=https://shakumbhariauto.in
